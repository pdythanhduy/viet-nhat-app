  "common_mistakes": [
    {
      "mistake": "社長がおっしゃいました (nói với khách)",
      "correct": "社長が申しておりました",
      "rule": "Sếp mình + người ngoài → KENJOUGO"
    },
    {
      "mistake": "ご確認いたします",
      "correct": "確認いたします",
      "rule": "ご/お không thêm trước hành động của MÌNH khi đã dùng いたす"
    },
    {
      "mistake": "お客様が参りました",
      "correct": "お客様がいらっしゃいました",
      "rule": "Khách hàng → SONKEIGO, không dùng kenjougo"
    },
    {
      "mistake": "先生、レポートを拝見してください",
      "correct": "先生、レポートをご覧になってください",
      "rule": "Nhờ người khác xem → ご覧になる (sonkeigo)"
    },
    {
      "mistake": "部長様にご報告します",
      "correct": "部長にご報告します",
