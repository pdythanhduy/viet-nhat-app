{
  "name": "viet-nhat-app",
  "version": "1.5.2",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "verify": "npm run typecheck && npm run test:ci && npm run verify:content",
    "verify:content": "npm run content:audit-encoding && npm run bjt:qa-checklist:gate",
    "verify:precommit": "npm run typecheck && npm run verify:content",
    "jlpt:generate": "tsx scripts/generate-jlpt-content.ts",
    "jlpt:bundle": "tsx scripts/bundle-jlpt-content.ts",
    "jlpt:upload": "tsx scripts/upload-jlpt-content.ts",
    "bjt:audit-batch": "node scripts/bjt-audit-batch.js",
    "bjt:audit-mock-v2": "node scripts/bjt-audit-mock-v2.js",
    "bjt:audit-runtime": "node scripts/bjt-audit-runtime.js",
    "bjt:export-legacy-runtime": "node scripts/bjt-export-legacy-runtime.js",
    "bjt:partition-ultimate": "node scripts/bjt-partition-ultimate.js",
    "bjt:manifest-snippet": "node scripts/bjt-manifest-snippet.js",
    "bjt:init-batch": "node scripts/bjt-init-batch.js",
    "bjt:qa-checklist": "node scripts/bjt-qa-checklist.js",
    "bjt:qa-fix-cues": "node scripts/bjt-qa-checklist.js --fix-cues",
    "bjt:qa-checklist:strict": "node scripts/bjt-qa-checklist.js --strict",
    "bjt:qa-checklist:gate": "node scripts/bjt-qa-checklist.js --max-warnings 0",
    "bjt:explanation-cleanup": "node scripts/bjt-explanation-cleanup.js --write",
    "bjt:distractor-audit": "node scripts/bjt-distractor-audit.js --out docs/bjt/document/partitioned/distractor-audit.json",
    "bjt:coverage-gap": "node scripts/bjt-coverage-gap.js",
    "bjt:seed-gap-j54": "node scripts/bjt-seed-gap-batch-j54.js",
    "git:hooks:setup": "node scripts/setup-git-hooks.js",
    "content:audit-encoding": "node scripts/content-encoding-audit.js",
    "content:fix-encoding": "node scripts/content-encoding-audit.js --fix",
    "content:upload": "tsx scripts/upload-content.ts",
    "content:qa-admin-guides": "jest adminGuides.qa.test.ts adminGuideDatabase.test.ts --runInBand"
  },
  "dependencies": {
    "@aptabase/react-native": "^0.4.0",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@supabase/supabase-js": "^2.105.3",
    "expo": "~54.0.35",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-purchases": "^10.4.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "29.5.14",
    "@types/node": "^18.19.130",
    "@types/react": "~19.1.10",
    "jest-expo": "~54.0.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
