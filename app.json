{
  "expo": {
    "name": "Cẩm Nang Việt Nhật",
    "slug": "viet-nhat-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#185FA5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thanhduy.camnangvietnhat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Ứng dụng dùng thông báo để nhắc ngày quan trọng như giấy tờ sắp hết hạn, deadline thủ tục, và nhắc học theo lựa chọn của bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#185FA5"
      },
      "package": "com.thanhduy.camnangvietnhat",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#185FA5",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4e65f257-8cca-4bf1-9220-1ae7f5bf535a"
      },
      "aptabaseAppKey": ""
    },
    "owner": "tt-duy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4e65f257-8cca-4bf1-9220-1ae7f5bf535a"
    }
  }
}
