{
  "expo": {
    "name": "Cẩm Nang Việt Nhật",
    "slug": "viet-nhat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/viet-nhat-logo-512.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#185FA5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thanhduy.camnangvietnhat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/viet-nhat-logo-512.jpg",
        "backgroundColor": "#185FA5"
      },
      "package": "com.thanhduy.camnangvietnhat",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#185FA5",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4e65f257-8cca-4bf1-9220-1ae7f5bf535a"
      }
    },
    "owner": "tt-duy"
  }
}
